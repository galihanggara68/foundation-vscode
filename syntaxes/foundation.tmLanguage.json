{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Foundation",
  "scopeName": "source.fdn",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#traits" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.fdn",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.fdn",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.fdn",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.fdn",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.fdn",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.fdn",
          "match": "\\bnull\\b"
        }
      ]
    },
    "traits": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.fdn",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.declaration.fdn",
          "match": "\\b(entity|actor|value|enum|event|error|action|scenario)\\b"
        },
        {
          "name": "keyword.control.statement.fdn",
          "match": "\\b(let|query|single|many|where|sort|asc|desc|limit|offset|validate|else|emit|return|step|when|expect|create|update)\\b"
        },
        {
          "name": "keyword.operator.logical.fdn",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.fdn",
          "match": "\\b(UUID|String|Int|Boolean|Money|Decimal|Timestamp|Date|JSON|Bytes|Email|uuid|string|int|bool|boolean|decimal|timestamp|date|json|bytes|email)\\b"
        },
        {
          "name": "entity.name.type.fdn",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.fdn",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arrow.fdn",
          "match": "->"
        },
        {
          "name": "keyword.operator.assignment.fdn",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.fdn",
          "match": "(\\+|-|\\*|/)"
        }
      ]
    }
  }
}
